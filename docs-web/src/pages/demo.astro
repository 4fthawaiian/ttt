---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage frontmatter={{ title: 'Demo', description: 'Try TTT Editor in your browser.', template: 'splash', tableOfContents: false, pagefind: false, pagination: false }}>
  <section id="demo-page" aria-label="TTT playground">
    <div class="demo-shell">
    <div class="demo-notice">
      <p><strong>Limited demo.</strong> Explore and edit ttt’s source. Edits reset on reload. Git, LSP, plugins, and the shell require the desktop editor. <span class="focus-hint">F6 returns focus to navigation.</span></p>
      <button id="reset-demo" type="button">Reset demo</button>
    </div>
    <iframe id="demo-frame" src="/playground/index.html" title="Interactive TTT editor" allow="clipboard-read; clipboard-write"></iframe>
    </div>
  </section>
</StarlightPage>

<script>
  window.addEventListener('message', (event) => {
    const frame = document.getElementById('demo-frame') as HTMLIFrameElement;
    if (event.origin === location.origin && event.source === frame.contentWindow && event.data?.type === 'ttt-focus-docs') {
      (document.querySelector('.demo-link') as HTMLAnchorElement)?.focus();
    }
  });
  document.getElementById('reset-demo')?.addEventListener('click', () => {
    if (window.confirm('Reset the demo? All edits in this session will be discarded.')) {
      const frame = document.getElementById('demo-frame') as HTMLIFrameElement;
      frame.src = frame.src;
    }
  });
</script>

<style>
  :global(body:has(#demo-page)) { overflow: hidden; }
  #demo-page { position: fixed; inset: var(--sl-nav-height) 0 0; display: flex; align-items: center; justify-content: center; padding: 1.5rem; background: var(--sl-color-bg); }
  .demo-shell { display: flex; flex-direction: column; width: min(100%, 1100px); max-height: 100%; border: 1px solid var(--sl-color-gray-5); border-radius: 0.6rem; overflow: hidden; }
  .demo-notice { display: flex; align-items: center; gap: 1rem; padding: 0.6rem 1rem; background-color: #1f1f1f; }
  .demo-notice p { flex: 1; margin: 0; font-size: 0.75rem; line-height: 1.5; }
  .focus-hint { white-space: nowrap; }
  button { flex-shrink: 0; margin: 0; padding: 0.4rem 0.7rem; border: 1px solid var(--sl-color-gray-5); border-radius: 0.4rem; background: var(--sl-color-bg); color: var(--sl-color-white); cursor: pointer; font: inherit; font-size: 0.75rem; }
  button:hover { border-color: var(--sl-color-accent); }
  iframe { display: block; flex: 0 1 750px; height: 750px; min-height: 0; width: 100%; border: 0; margin: 0; }
  @media (max-width: 40rem) { #demo-page { padding: 0.5rem; } .demo-notice { align-items: flex-start; gap: 0.5rem; } }
</style>
